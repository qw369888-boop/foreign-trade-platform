# ==========================================
# 数据库配置
# ==========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/foreign_trade_db"

# ==========================================
# 后端服务配置
# ==========================================
NODE_ENV=development
PORT=4000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# 前端 URL（用于 CORS 和回调）
FRONTEND_URL=http://localhost:3000

# ==========================================
# 支付网关配置
# ==========================================

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Stripe
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# 支付宝国际版
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-alipay-private-key
ALIPAY_PUBLIC_KEY=your-alipay-public-key

# ==========================================
# 邮件服务配置
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourcompany.com

# ==========================================
# 社交媒体 API 配置
# ==========================================

# LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_PAGE_ACCESS_TOKEN=your-page-access-token

# Instagram (通过 Facebook Graph API)
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-id

# Twitter/X (可选)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret

# ==========================================
# WhatsApp Business API
# ==========================================
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-verify-token

# ==========================================
# 机器人系统配置
# ==========================================
BOT_PORT=5000

# 自动拓客配置
AUTO_OUTREACH_ENABLED=true
OUTREACH_DAILY_LIMIT=50
OUTREACH_INTERVAL_MINUTES=30

# CRM 配置
CRM_AUTO_FOLLOW_UP=true
FOLLOW_UP_DAYS=3,7,14

# 数据分析
ANALYTICS_ENABLED=true

# ==========================================
# 文件存储配置
# ==========================================
# 本地存储
UPLOAD_DIR=./uploads

# AWS S3 (可选)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# ==========================================
# Redis 配置（用于缓存和队列）
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# 其他配置
# ==========================================
# 日志级别
LOG_LEVEL=info

# 汇率 API（用于货币转换）
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# Google Analytics (可选)
GA_TRACKING_ID=UA-XXXXXXXXX-X

# reCAPTCHA (防止机器人)
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
